BOT_TOKEN=
SESSION_ENCRYPTION_KEY=
# Opcional e temporária: use a antiga chave/token somente durante a migração de sessões legadas.
SESSION_LEGACY_KEY=

# Opcional. No Railway, prefira anexar um Volume; RAILWAY_VOLUME_MOUNT_PATH é automático.
DATA_DIR=
SCREENSHOT_RETENTION_DAYS=90

# Em Railway, mantenha true para impedir que o bot rode sem Volume persistente.
REQUIRE_PERSISTENT_STORAGE=true
# ID do grupo principal para receber alerta caso a persistencia esteja ausente.
CLAN_CHAT_ID=
