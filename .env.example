# Token do BotFather (obrigatório)
BOT_TOKEN=

# Base da API de dados do MLBB (opcional).
# Padrão: https://arena.rone.dev/api
# Se você hospeda sua própria API na Railway, aponte aqui.
MLBB_API_URL=

# Porta do healthcheck HTTP. Na Railway isso é injetado automaticamente.
PORT=3000

# --- Persistência das sessões ---
# Na Railway, adicione um Volume: RAILWAY_VOLUME_MOUNT_PATH é usada sozinha.
# Ou defina o caminho completo manualmente:
SESSION_FILE=

# --- Modo webhook (opcional; o padrão é long polling, que funciona sem config) ---
# USE_WEBHOOK=true          # usa https://$RAILWAY_PUBLIC_DOMAIN automaticamente
# WEBHOOK_URL=              # ou informe a URL pública completa
# WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=  # string aleatória para validar o header do Telegram

# --- Ajustes finos (opcionais) ---
# API_TIMEOUT_MS=12000
# API_RETRIES=2
# REGISTRATION_TTL_MS=600000
